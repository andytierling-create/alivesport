# Local two-sided mock (Join, Sign in, Play, Club desk).
# Dev: on by default. Set to 0 to hide it.
# Vercel production: leave unset (or 0) so fake login cannot ship.
# NEXT_PUBLIC_ALIVE_DEMO=1

# Neon pooled connection string. When set, the platform store uses Postgres.
# When unset, the store falls back to .data/platform.json.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# CORS origin for /api/* (Expo web). Leave unset for * while the demo is local.
# ALIVE_CORS_ORIGIN=http://localhost:8081
